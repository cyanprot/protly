{
  "manifest_version": 3,
  "name": "protly",
  "version": "0.1.0",
  "key": "",
  "description": "Translate Instagram DMs and Gmail drafts with Claude.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "activeTab"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "protly",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options/options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "css": [
        "src/content/style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content/gmail/loader.js"
      ],
      "css": [
        "src/content/gmail/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/lib/*.js",
        "src/ui/*.js",
        "src/ui/fonts/*.woff2"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    },
    {
      "resources": [
        "src/content/gmail/*.js",
        "src/lib/*.js",
        "src/ui/*.js",
        "src/ui/fonts/*.woff2"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
