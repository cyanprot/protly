{
  "manifest_version": 3,
  "name": "protly",
  "version": "0.1.0",
  "key": "",
  "description": "Translate Instagram DMs and Gmail drafts with Claude.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.instagram.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "protly",
    "default_popup": "popup/popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options/options.html",
  "commands": {
    "run": {
      "suggested_key": { "default": "Alt+T" },
      "description": "Translate or polish the focused text box"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "css": [
        "src/content/style.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/content/gmail/loader.js"
      ],
      "css": [
        "src/content/gmail/style.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/dom.js",
        "src/content/main.js",
        "src/content/outgoing.js",
        "src/content/panel.js",
        "src/content/selectors.js",
        "src/lib/classify.js",
        "src/lib/command.js",
        "src/lib/flags.js",
        "src/lib/ime.js",
        "src/lib/keys.js",
        "src/lib/lang.js",
        "src/lib/limits.js",
        "src/lib/preview.js",
        "src/ui/card.css.js",
        "src/ui/card.js",
        "src/ui/errors.js",
        "src/ui/fonts.js",
        "src/ui/panel.css.js",
        "src/ui/theme.js",
        "src/ui/toast.css.js",
        "src/ui/toast.js",
        "src/ui/tokens.css.js",
        "src/ui/fonts/protly-mono-400.woff2",
        "src/ui/fonts/protly-mono-500.woff2"
      ],
      "matches": [
        "https://www.instagram.com/*"
      ]
    },
    {
      "resources": [
        "src/content/gmail/body.js",
        "src/content/gmail/compose.js",
        "src/content/gmail/main.js",
        "src/content/gmail/selectors.js",
        "src/content/gmail/thread.js",
        "src/lib/command.js",
        "src/lib/flags.js",
        "src/lib/ime.js",
        "src/lib/lang.js",
        "src/lib/limits.js",
        "src/ui/card.css.js",
        "src/ui/card.js",
        "src/ui/errors.js",
        "src/ui/fonts.js",
        "src/ui/theme.js",
        "src/ui/tokens.css.js",
        "src/ui/trust.js",
        "src/ui/fonts/protly-mono-400.woff2",
        "src/ui/fonts/protly-mono-500.woff2"
      ],
      "matches": [
        "https://mail.google.com/*"
      ]
    }
  ]
}
